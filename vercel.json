{
  "version": 2,
  "functions": {
    "api/index.js": { "maxDuration": 30 }
  },
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/:path*",           "destination": "/api/index.js" },
    { "source": "/employee",             "destination": "/employee/index.html" },
    { "source": "/admin",                "destination": "/admin/index.html" },
    { "source": "/restaurant/dashboard", "destination": "/restaurant/dashboard.html" },
    { "source": "/restaurant/login",     "destination": "/restaurant/login.html" },
    { "source": "/restaurant/register",  "destination": "/restaurant/register.html" },
    { "source": "/company/admin",        "destination": "/company/admin.html" },
    { "source": "/company/login",        "destination": "/company/login.html" },
    { "source": "/company/register",     "destination": "/company/register.html" },
    { "source": "/employee/login",       "destination": "/employee/login.html" }
  ],
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type",                "value": "application/manifest+json" },
        { "key": "Cache-Control",               "value": "public, max-age=0, must-revalidate" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Content-Type",           "value": "application/javascript" },
        { "key": "Cache-Control",          "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/reminder_9h",  "schedule": "0 9 * * 1-5" },
    { "path": "/api/cron/reminder_10h", "schedule": "0 10 * * 1-5" },
    { "path": "/api/cron/reminder_11h", "schedule": "0 11 * * 1-5" }
  ]
}
